---
/**
 * Documentos sueltos del contenido (pre-trabajos y recursos).
 * Las rutas salen de DOCS en lib/rutas.ts; el id de la colección se compara sin mayúsculas
 * porque el loader glob normaliza "README.md" a "readme".
 */
import { getCollection, render } from "astro:content";
import Curso from "../layouts/Curso.astro";
import Cabecera from "../components/Cabecera.astro";
import { docDeEntrada } from "../lib/curso";

export async function getStaticPaths() {
  const entradas = await getCollection("docs");
  return entradas.flatMap((entry) => {
    const doc = docDeEntrada(entry);
    if (!doc) return [];
    // "/recursos/" → param "recursos"; "/pre-trabajos/1/" → "pre-trabajos/1"
    const ruta = doc.ruta.replace(/^\/|\/$/g, "");
    return [{ params: { ruta }, props: { entry, doc } }];
  });
}

const { entry, doc } = Astro.props;
const { Content, headings } = await render(entry);
const h1 = (entry.body ?? "").match(/^#\s+(.+?)\s*$/m)?.[1] ?? doc.titulo;
---

<Curso title={doc.titulo} headings={headings} tipo="Documento">
  <Cabecera eyebrow={doc.grupo === "pre" ? "Pre-trabajos" : "Recursos"} titulo={h1} headings={headings} />
  <article class="prose rise d1">
    <Content />
  </article>
</Curso>
